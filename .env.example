# Copy this file to .env and fill in the values. NEVER commit .env.
# This template only documents variable names; it must not contain real secrets.

# REQUIRED. Signs the session cookie. Leave it empty here: the app refuses to
# start without a value. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# REQUIRED. Protects the encryption keys stored in the database. It must be
# 64 hexadecimal characters (32 bytes) and DIFFERENT from SECRET_KEY, so run
# the same command again to get a second value. Keep a backup in a safe place:
# if it is lost, every stored file becomes unreadable.
MASTER_KEY=

# Set to 1 only on your own machine during development (enables the Flask debugger).
FLASK_DEBUG=0

# Set to 1 when the site is served over HTTPS, so the browser sends the login
# cookie only over encrypted connections. Keep 0 for local http://127.0.0.1:
# with 1 some browsers (Safari) drop the cookie and nobody can log in.
SESSION_COOKIE_SECURE=0

# Optional. If unset, the app uses a SQLite file inside the instance/ folder.
# DATABASE_URL=

# Optional. Folder for the encrypted files. A relative path is relative to the
# project folder. If unset, instance/storage is used.
# STORAGE_DIR=

# Maximum size of one upload request, in megabytes. Every upload is stored as
# three encrypted copies, so it needs about three times this much disk space.
MAX_UPLOAD_MB=50
